# ============================================================================
# Global Environment Configuration for Fluent Speech Project
# ============================================================================
# Copy this file to .env and update with your actual values

# ============================================================================
# Database Configuration (TimescaleDB/PostgreSQL)
# ============================================================================
DB_NAME=fluent
DB_HOST=timescaledb
DB_PORT=5432
DB_USERNAME=fluent
DB_PASSWORD=root

# ============================================================================
# Service Ports
# ============================================================================
API_GATEWAY_PORT=8000
API_GW_PORT=8000
VIDEO_ANALYSIS_PORT=8001
ARM_MOVEMENT_PORT=8002
EYE_CONTACT_PORT=8003
AUDIO_ANALYSIS_PORT=8004

# ============================================================================
# Service URLs (for inter-service communication)
# ============================================================================
API_GATEWAY_URL=http://api-gateway:8000
VIDEO_ANALYSIS_SERVICE_URL=http://video-analysis:8001
AUDIO_ANALYSIS_SERVICE_URL=http://audio-analysis:8004

# ============================================================================
# Storage Paths
# ============================================================================
VIDEO_STORAGE_PATH=/app/video_data

# ============================================================================
# Django Secret Keys (Change these in production!)
# ============================================================================
DJANGO_SECRET_KEY_VIDEO=django-insecure-video-analysis-dev-key-2024
DJANGO_SECRET_KEY_AUDIO=django-insecure-audio-analysis-dev-key-2024
DJANGO_SECRET_KEY_ARM=django-insecure-arm-movement-dev-key-2024
DJANGO_SECRET_KEY_EYE=django-insecure-eye-contact-dev-key-2024

# ============================================================================
# Django Configuration
# ============================================================================
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,api-gateway,video-analysis,audio-analysis,arm-movement,eye-contact
ALLOWED_HOSTS_VIDEO=localhost,api-gateway
ALLOWED_HOSTS_AUDIO=localhost,api-gateway,video-analysis
ALLOWED_HOSTS_EYE=localhost,api-gateway
ALLOWED_HOSTS_ARM=localhost,api-gateway
# ============================================================================
# Video Analysis Configuration
# ============================================================================
FRAME_INTERVAL=0.2

# ============================================================================
# Audio Extraction Configuration
# ============================================================================
AUDIO_SAMPLE_RATE=22050

# ============================================================================
# Arm Movement Analysis Configuration
# ============================================================================
NO_MOVEMENT_VELOCITY_THRESHOLD=0.01
EXCESSIVE_MOVEMENT_VELOCITY_THRESHOLD=0.15
MIN_CONSECUTIVE_FRAMES=3

SEGMENTATION_WINDOW_SIZE=15
AVERAGE_CHANGE_THRESHOLD=0.08
TREND_CHANGE_THRESHOLD=0.008
MIN_SEGMENT_GAP=20

# ============================================================================
# Eye Contact Analysis Configuration
# ============================================================================
# Heatmap Bin Ranges
YAW_MIN=-60
YAW_MAX=60
YAW_BIN_SIZE=5

PITCH_MIN=-30
PITCH_MAX=30
PITCH_BIN_SIZE=5

# Audience Zone Thresholds
AUDIENCE_YAW_MIN=-30
AUDIENCE_YAW_MAX=30
AUDIENCE_PITCH_MIN=-15
AUDIENCE_PITCH_MAX=15

# Event Detection (Eye Contact)
EYE_CONTACT_MIN_CONSECUTIVE_FRAMES=5

# Staring Detection
STARING_ANGLE_THRESHOLD=3
MIN_STARING_FRAMES=30
