# Database configuration
DB_NAME=fluent
DB_HOST=localhost # use timescaledb in prod
DB_PORT=5432
DB_USERNAME=fluent
DB_PASSWORD=root

# Service Ports
API_GATEWAY_PORT=8000
VIDEO_ANALYSIS_PORT=8001
ARM_MOVEMENT_PORT=8002
EYE_CONTACT_PORT=8003
AUDIO_ANALYSIS_PORT=8004
PITCH_ANALYSIS_PORT=8005
VOLUME_ANALYSIS_PORT=8006
HIP_ANALYSIS_PORT=8007
FILLER_WORDS_PORT=8008
TRANSCRIPT_SERVICE_PORT=8009
SEGMENTATION_ANALYSIS_PORT=8010
ORCHERSTRATOR_PORT=8011
PERFORMANCE_MS_PORT=8012
PROCESSING_ORCHESTRATOR_PORT=8013

# Service URLs
API_GATEWAY_URL=http://api-gateway:8000
AUDIO_ANALYSIS_SERVICE_URL=http://localhost:8004 # audio-analysis for prod
SEGMENTATION_SERVICE_URL=http://localhost:8010 # segmentation for prod
VIDEO_PROCESSING_SERVICE_URL=http://localhost:8001
AUDIO_PROCESSING_SERVICE_URL=http://localhost:8004
TRANSCRIPT_PROCESSING_SERVICE_URL=http://localhost:8009
PROCESSING_ORCHESTRATOR_URL=http://localhost:8013
# Storage Path
VIDEO_STORAGE_PATH=D:\VideoData # use /app/video_data in prod
WHISPER_CACHE_DIR=D:\ModelCache\whisper

# Django Secret Keys
DJANGO_SECRET_KEY_VIDEO=
DJANGO_SECRET_KEY_AUDIO=
DJANGO_SECRET_KEY_ARM=
DJANGO_SECRET_KEY_EYE=
DJANGO_SECRET_KEY_PITCH=
DJANGO_SECRET_KEY_VOLUME=
DJANGO_SECRET_KEY_HIP=
DJANGO_SECRET_KEY_FILLER=
DJANGO_SECRET_KEY_SEGMENTATION=
DJANGO_SECRET_KEY_PERFORMANCE=


# Django Configuration
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,api-gateway,video-analysis,audio-analysis,arm-movement,eye-contact,pitch-analysis,volume-analysis,hip-analysis,filler-words
ALLOWED_HOSTS_VIDEO=localhost,api-gateway
ALLOWED_HOSTS_AUDIO=localhost,api-gateway
ALLOWED_HOSTS_EYE=localhost,api-gateway
ALLOWED_HOSTS_ARM=localhost,api-gateway
ALLOWED_HOSTS_PITCH=localhost,api-gateway
ALLOWED_HOSTS_VOLUME=localhost,api-gateway
ALLOWED_HOSTS_HIP=localhost,api-gateway
ALLOWED_HOSTS_FILLER=localhost,api-gateway
ALLOWED_HOSTS_SEGMENTATION=localhost,127.0.0.1,api-gateway,segmentation
ALLOWED_HOSTS_PERFORMANCE=localhost,127.0.0.1,orchestrator
ALLOWED_HOSTS_ORCHESTRATOR=localhost,127.0.0.1,api-gateway,fluent_api_gateway
# Video processing Configuration
FRAME_INTERVAL=0.1
AUDIO_SAMPLE_RATE=16000
VIDEO_DEBUG_OUTPUT=False

# Transcript options
WHISPER_MODEL=medium
WHISPER_WORD_TIMESTAMPS=True
WHISPER_TEMPERATURE=0.0
WHISPER_NO_SPEECH_THRESHOLD=0.2
WHISPER_LOGPROB_THRESHOLD=-1.0
WHISPER_COMPRESSION_RATIO_THRESHOLD=3.0
MIN_AUDIO_DURATION=1.0
SAVE_TRANSCRIPT_TO_FILE=True

# Audio Processing Configuration
NOISE_REDUCTION_ENABLED=True
NOISE_REDUCTION_PROP_DECREASE=0.5

# Eye Contact Analysis Configuration
PITCH_MIN=-30
PITCH_MAX=30
PITCH_BIN_SIZE=5
PITCH_SCALE=500
PITCH_BIAS=0  # per-video median normalization handles offset automatically

YAW_MIN=-70
YAW_MAX=70
YAW_BIN_SIZE=5
YAW_SMOOTHING_WINDOW=5

AUDIENCE_YAW_MIN=-40
AUDIENCE_YAW_MAX=40
AUDIENCE_PITCH_MIN=-15
AUDIENCE_PITCH_MAX=15

EYE_CONTACT_MIN_LOOKING_AWAY_DURATION=500
STARING_ANGLE_THRESHOLD=10
MIN_STARING_MS=2000
BACK_FACING_THRESHOLD=0
EYE_SEGMENTATION_SENSITIVITY=0.5

# Hand Analysis Configuration
NO_MOVEMENT_VELOCITY_THRESHOLD=0.18
EXCESSIVE_Z_SCORE_K=2.5
EXCESSIVE_ROLLING_WINDOW=10
# MIN_CONSECUTIVE_DURATION_MS: Minimum continuous no-movement duration to flag (ms)
#   Natural pauses between gestures are ~1-3s — set above this to avoid false positives
MIN_CONSECUTIVE_DURATION_MS=4000
EXCESSIVE_MERGE_GAP_MS=2000
# EXCESSIVE_MIN_DURATION_MS: Minimum duration of an excessive-movement period after merging (ms)
EXCESSIVE_MIN_DURATION_MS=1000
ARM_SEGMENTATION_SENSITIVITY=0.7

# Hip config
MIN_HIP_DIRECTION_CHANGES=3
MIN_HIP_AMPLITUDE_CHANGE=0.015
HIP_WINDOW_DURATION_MS=5000
HIP_SEGMENTATION_BIN_SIZE=5.0
HIP_SEGMENTATION_SENSITIVITY=1

# Voice pitch config
PITCH_ENERGY_THRESHOLD=0.002
PITCH_GRACE_PERIOD_MS=0
PITCH_MEDIAN_FILTER_SIZE=5
MONOTONOUS_WINDOW_MS=1500
MONOTONOUS_STD_THRESHOLD=3
MONOTONOUS_RANGE_THRESHOLD=12.0
MONOTONOUS_MERGE_GAP_MS=3000
MONOTONOUS_MIN_DURATION_MS=1500
PITCH_SEGMENTATION_SENSITIVITY=0.2

# Volume config
VOLUME_SILENCE_FLOOR_DBFS=-60.0
VOLUME_SOFT_MARGIN_DB=7.0
VOLUME_LOUD_MARGIN_DB=4.0
VOLUME_MIN_SEGMENT_MS=1000
# VOLUME_MERGE_GAP_S: max gap between violation frames to merge into one segment (s)
VOLUME_MERGE_GAP_S=0.5
# VOLUME_MIN_BAD_FRAME_COVERAGE: min fraction of frames in merged segment that must actually violate threshold
#   0.5 = at least half the frames must be too-soft/too-loud (filters brief dip artifacts)
#   lower = more lenient (catches more), higher = stricter (fewer false positives)
VOLUME_MIN_BAD_FRAME_COVERAGE=0.6
VOLUME_SEGMENTATION_SENSITIVITY=0.2

# Filler words config
HIGH_FILLER_THRESHOLD=5
MIN_SPEECH_DURATION=8
FILLER_MIN_WORD_PROBABILITY=0.5
# Sliding window stable-pitch candidate detection
UHH_WINDOW_MS=200
UHH_MIN_VOICED_FRACTION=0.5
UHH_PITCH_STD_THRESHOLD=2.5
UHH_MIN_VOICED_DURATION_MS=550
UHH_MAX_RUN_DURATION_MS=1050
# Spectral flux threshold — candidates with flux below this pass the filter
UHH_FLUX_MAX=18
# Bottom-up zone detection
# FILLER_SEGMENTATION_BIN_SIZE: window size in seconds for density bins (smaller = finer, min ~5s)
FILLER_SEGMENTATION_BIN_SIZE=10.0
# FILLER_BOTTOM_UP_MERGE_K: merge stops when adjacent segment means differ by > k × std(rates)
#   lower (0.5) = more separate segments, stricter zones
#   higher (2.0) = fewer, broader segments
FILLER_BOTTOM_UP_MERGE_K=1.0
# FILLER_PEAK_ZONE_MULTIPLIER: a segment is a zone if its rate > multiplier × overall rate
#   2.0 = must be 2× average to flag (strict, few false positives)
#   1.5 = more sensitive
FILLER_PEAK_ZONE_MULTIPLIER=2.0

# Segmentation config
SEGMENTATION_MIN_PENALTY=1.0
SEGMENTATION_MAX_PENALTY=500.0
SEGMENTATION_DEFAULT_SENSITIVITY=0.5
SEGMENTATION_MIN_SEGMENT_SAMPLES=2

# Performance dimension weights (model v2/v3 — empirically derived from research, n=47)
# Derived from standardized beta coefficients: voice=0.83, fluency=0.60, eye=0.60, body=0.21
WEIGHT_VOICE=0.37
WEIGHT_FLUENCY=0.27
WEIGHT_EYE_CONTACT=0.27
WEIGHT_BODY=0.09

# Filler distribution penalty (model v3 — H2.1 finding: uniform fillers perceived worse)
# Uses bottom-up segmentation result from filler_words_ms (peak_zones.distribution):
#   even → full MAX_PENALTY added to fluency score
#   concentrated → 0 penalty
FILLER_DISTRIBUTION_MAX_PENALTY=7.0
