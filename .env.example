# ============================================================================
# Global Environment Configuration for Fluent Speech Project
# ============================================================================
# Copy this file to .env and fill in your values.
# In Docker use container names for DB_HOST and service URLs.
# For local dev use localhost.

# Database (TimescaleDB/PostgreSQL)
DB_NAME=fluent
DB_HOST=timescaledb
DB_PORT=5432
DB_USERNAME=fluent
DB_PASSWORD=changeme

# Service Ports
API_GATEWAY_PORT=8000
VIDEO_ANALYSIS_PORT=8001
ARM_MOVEMENT_PORT=8002
EYE_CONTACT_PORT=8003
AUDIO_ANALYSIS_PORT=8004
PITCH_ANALYSIS_PORT=8005
VOLUME_ANALYSIS_PORT=8006
HIP_ANALYSIS_PORT=8007
FILLER_WORDS_PORT=8008
TRANSCRIPT_SERVICE_PORT=8009
SEGMENTATION_ANALYSIS_PORT=8010
ORCHERSTRATOR_PORT=8011
PERFORMANCE_MS_PORT=8012
PROCESSING_ORCHESTRATOR_PORT=8013

# Service URLs (use container names in Docker)
API_GATEWAY_URL=http://api-gateway:8000
AUDIO_ANALYSIS_SERVICE_URL=http://audio-analysis:8004
SEGMENTATION_SERVICE_URL=http://segmentation:8010
VIDEO_PROCESSING_SERVICE_URL=http://video-analysis:8001
AUDIO_PROCESSING_SERVICE_URL=http://audio-analysis:8004
TRANSCRIPT_PROCESSING_SERVICE_URL=http://transcript_service:8009
PROCESSING_ORCHESTRATOR_URL=http://processing-orchestrator:8013

# Storage paths (use /app/video_data in Docker)
VIDEO_STORAGE_PATH=/app/video_data
WHISPER_CACHE_DIR=/app/model_cache/whisper

# Django Secret Keys (generate unique keys for production)
DJANGO_SECRET_KEY_VIDEO=change-me
DJANGO_SECRET_KEY_AUDIO=change-me
DJANGO_SECRET_KEY_ARM=change-me
DJANGO_SECRET_KEY_EYE=change-me
DJANGO_SECRET_KEY_PITCH=change-me
DJANGO_SECRET_KEY_VOLUME=change-me
DJANGO_SECRET_KEY_HIP=change-me
DJANGO_SECRET_KEY_FILLER=change-me
DJANGO_SECRET_KEY_SEGMENTATION=change-me
DJANGO_SECRET_KEY_PERFORMANCE=change-me

# Django
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1
ALLOWED_HOSTS_VIDEO=localhost,api-gateway
ALLOWED_HOSTS_AUDIO=localhost,api-gateway
ALLOWED_HOSTS_EYE=localhost,api-gateway
ALLOWED_HOSTS_ARM=localhost,api-gateway
ALLOWED_HOSTS_PITCH=localhost,api-gateway
ALLOWED_HOSTS_VOLUME=localhost,api-gateway
ALLOWED_HOSTS_HIP=localhost,api-gateway
ALLOWED_HOSTS_FILLER=localhost,api-gateway
ALLOWED_HOSTS_SEGMENTATION=localhost,127.0.0.1,api-gateway,segmentation
ALLOWED_HOSTS_PERFORMANCE=localhost,127.0.0.1,orchestrator
ALLOWED_HOSTS_ORCHESTRATOR=localhost,127.0.0.1,api-gateway,fluent_api_gateway

# Processing
FRAME_INTERVAL=0.1
AUDIO_SAMPLE_RATE=16000

# Whisper
WHISPER_MODEL=medium
WHISPER_WORD_TIMESTAMPS=True
WHISPER_TEMPERATURE=0.0
WHISPER_NO_SPEECH_THRESHOLD=0.2
WHISPER_LOGPROB_THRESHOLD=-1.0
WHISPER_COMPRESSION_RATIO_THRESHOLD=3.0
MIN_AUDIO_DURATION=1.0
SAVE_TRANSCRIPT_TO_FILE=True

# Eye Contact Analysis
YAW_MIN=-90
YAW_MAX=90
YAW_BIN_SIZE=5
PITCH_MIN=-30
PITCH_MAX=30
PITCH_BIN_SIZE=5
PITCH_SCALE=500
PITCH_BIAS=10
PITCH_DEBUG_OFFSET=10
AUDIENCE_YAW_MIN=-60
AUDIENCE_YAW_MAX=60
AUDIENCE_PITCH_MIN=-15
AUDIENCE_PITCH_MAX=15
EYE_CONTACT_MIN_LOOKING_AWAY_DURATION=1000
STARING_ANGLE_THRESHOLD=10
MIN_STARING_MS=2000
YAW_SMOOTHING_WINDOW=5
BACK_FACING_THRESHOLD=-0.1
EYE_SEGMENTATION_SENSITIVITY=0.5

# Hand Analysis
NO_MOVEMENT_VELOCITY_THRESHOLD=0.2
EXCESSIVE_MOVEMENT_VELOCITY_THRESHOLD=0.30
MIN_CONSECUTIVE_DURATION_MS=1000
EXCESSIVE_MIN_CONSECUTIVE_DURATION_MS=300
EXCESSIVE_MERGE_GAP_MS=2000
ARM_SEGMENTATION_SENSITIVITY=0.7

# Hip Analysis
MIN_HIP_DIRECTION_CHANGES=3
MIN_HIP_AMPLITUDE_CHANGE=0.02
HIP_WINDOW_DURATION_MS=4000
HIP_SEGMENTATION_BIN_SIZE=5.0
HIP_SEGMENTATION_SENSITIVITY=1

# Pitch Analysis
PITCH_GRACE_PERIOD_MS=100
PITCH_MEDIAN_FILTER_SIZE=5
MONOTONOUS_WINDOW_SIZE=30
MONOTONOUS_STD_THRESHOLD=6.5
MONOTONOUS_RANGE_THRESHOLD=20.0
MONOTONOUS_MERGE_GAP_MS=3000
MONOTONOUS_MIN_DURATION_MS=1500
PITCH_SEGMENTATION_SENSITIVITY=0.2

# Volume Analysis
VOLUME_TOO_SOFT_DBFS=-35.0
VOLUME_TOO_LOUD_DBFS=-10.0
VOLUME_SILENCE_FLOOR_DBFS=-60.0
VOLUME_MIN_SEGMENT_MS=1000
VOLUME_SEGMENTATION_SENSITIVITY=0.2

# Filler Words
HIGH_FILLER_THRESHOLD=5
MIN_SPEECH_DURATION=8
UHH_MIN_GAP_DURATION_MS=400
FILLER_SEGMENTATION_BIN_SIZE=10.0
FILLER_SEGMENTATION_SENSITIVITY=0.5

# Segmentation
SEGMENTATION_MIN_PENALTY=1.0
SEGMENTATION_MAX_PENALTY=500.0
SEGMENTATION_DEFAULT_SENSITIVITY=0.5
SEGMENTATION_MIN_SEGMENT_SAMPLES=2

# Performance weights (model v2/v3 — empirically derived from research, n=47)
WEIGHT_VOICE=0.37
WEIGHT_FLUENCY=0.27
WEIGHT_EYE_CONTACT=0.27
WEIGHT_BODY=0.09

# Filler distribution penalty (model v3)
FILLER_DISTRIBUTION_BINS=6
FILLER_DISTRIBUTION_MAX_PENALTY=20.0
FILLER_DISTRIBUTION_CV_THRESHOLD=1.0
